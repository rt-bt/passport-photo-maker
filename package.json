{
  "name": "passport-photo-maker",
  "version": "1.0.0",
  "description": "100% browser-based passport photo maker, background remover, compressor and print sheet generator",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "passport-photo",
    "photo-resizer",
    "background-removal",
    "client-side",
    "print-sheet",
    "compression",
    "id-photo"
  ],
  "author": "Passport Photo Maker Contributors",
  "license": "MIT",
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "canvas-confetti": "^1.9.4",
    "file-saver": "^2.0.5",
    "heic2any": "^0.0.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
