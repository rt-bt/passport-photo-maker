# Indian Design Studio - Environment Variables Configuration
# Copy this file to .env.local and populate the values below.

# Google Gemini API Key for AI Design Studio & Hindi Copywriter
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Razorpay Payment Gateway (Production Indian Payments)
# Get keys at: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# Optional Cloudflare R2 / S3 Object Storage for Cloud Asset Persistence
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="indian-design-studio-assets"

# NextAuth / Auth.js Secret (if integrating database authentication)
NEXTAUTH_SECRET="indian_design_studio_production_secret_key_987654"
NEXTAUTH_URL="http://localhost:3000"
